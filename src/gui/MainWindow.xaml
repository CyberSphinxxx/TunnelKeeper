<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TunnelKeeper - Minecraft Gateway"
        Height="720" Width="880"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Foreground="#F8FAFC">
    <Window.Resources>
        <!-- Modern ScrollViewer Style -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0B132B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#0B132B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Tab Bar -->
            <RowDefinition Height="*"/>    <!-- Tab Content -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Background="#0284C7" Margin="0,0,14,0">
                    <TextBlock Text="TK" FontWeight="Bold" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TunnelKeeper" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Dynamic Minecraft TCP Tunnel &amp; DNS Hot-Swap Gateway" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <!-- Header Quick Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="BtnMinimizeTray" Content="Minimize to Tray"
                        Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                        Padding="12,6" FontSize="12" Cursor="Hand" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>

        <!-- NAVIGATION TABS -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="4" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Name="NavTabDashboard" Grid.Column="0" Content="Dashboard"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"
                        Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                <Button Name="NavTabSettings" Grid.Column="1" Content="Settings"
                        Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold"
                        Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                <Button Name="NavTabLogs" Grid.Column="2" Content="Live Logs"
                        Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold"
                        Padding="0,10" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- CONTENT PANELS -->
        <Grid Grid.Row="2">

            <!-- ================= PAGE 1: DASHBOARD ================= -->
            <Grid Name="PanelDashboard" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Status Cards -->
                    <RowDefinition Height="Auto"/> <!-- Action Controls -->
                    <RowDefinition Height="*"/>    <!-- Activity Stream -->
                </Grid.RowDefinitions>

                <!-- TOP STATUS CARDS -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Service State -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="SERVICE STATE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <Border Name="BadgeStatus" Background="#450A0A" CornerRadius="8" Padding="10,6" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TextBlock Name="TxtBadgeStatus" Text="STOPPED" FontWeight="Bold" FontSize="12" Foreground="#F87171"/>
                            </Border>
                            <TextBlock Name="TxtProviderLabel" Text="Provider: Hostinger" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBlock Name="TxtLocalServerLabel" Text="Minecraft: Checking..." FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Public Domain -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PUBLIC SERVER ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock Name="TxtPublicDomain" Text="Configure domain in Settings" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                            <TextBlock Name="TxtLiveEndpoint" Text="SRV: Resolving live address..." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                            <Button Name="BtnCopyDomain" Content="Copy Server Address"
                                    Background="#0284C7" Foreground="White" FontWeight="SemiBold"
                                    Padding="12,6" FontSize="12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Rotation & Cycles -->
                    <Border Grid.Column="4" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="HOT-SWAP ROTATION" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <TextBlock Name="TxtSwapInfo" Text="Interval: ~55 min" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            <TextBlock Name="TxtCycleCount" Text="Cycles: 0 swaps" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBlock Name="TxtUptime" Text="Uptime: Idle" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ACTION BUTTONS -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="BtnToggleService" Grid.Column="0" Content="Start Tunnel Gateway"
                            Height="50" Background="#059669" Foreground="White" FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"/>

                    <Button Name="BtnRestartService" Grid.Column="2" Content="Force Restart"
                            Height="50" Background="#334155" Foreground="White" FontSize="14" FontWeight="SemiBold"
                            Padding="20,0" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- LIVE ACTIVITY STREAM (Mini Console) -->
                <Border Grid.Row="2" Background="#0B132B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="LIVE ACTIVITY" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock Name="TxtLogFileSummary" Text="" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBox Name="TxtDashboardLogs" Grid.Row="1"
                                 Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                 FontFamily="Consolas, monospace" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= PAGE 2: SETTINGS ================= -->
            <ScrollViewer Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">

                    <!-- Notification Banner -->
                    <Border Name="SettingsNoticeBanner" Background="#064E3B" CornerRadius="8" Padding="14,10" Margin="0,0,0,18" Visibility="Collapsed">
                        <TextBlock Name="TxtSettingsNotice" Text="Settings saved successfully to .env!" Foreground="#34D399" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- CARD 1: DNS Provider Selection -->
                    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="DNS Provider" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            <TextBlock Text="Select which provider manages your Minecraft server domain." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton Name="RadioHostinger" Content="Hostinger" GroupName="ProviderGroup"
                                             Foreground="White" FontSize="14" FontWeight="SemiBold" IsChecked="True" Margin="0,0,32,0"/>
                                <RadioButton Name="RadioCloudflare" Content="Cloudflare" GroupName="ProviderGroup"
                                             Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Hostinger Settings Block -->
                            <StackPanel Name="BlockHostinger">
                                <TextBlock Text="Hostinger API Token *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Name="TxtHostingerToken" Grid.Column="0" Margin="0,0,8,0"/>
                                    <TextBox Name="TxtHostingerTokenVisible" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <Button Name="BtnToggleHostingerToken" Grid.Column="1" Content="Show"
                                            Background="#334155" Foreground="White" Padding="14,6" FontSize="12" Cursor="Hand" BorderThickness="0"/>
                                </Grid>
                                <TextBlock Text="Requires DNS management permissions. Get it from Hostinger Dashboard > Profile > API" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Cloudflare Settings Block -->
                            <StackPanel Name="BlockCloudflare" Visibility="Collapsed">
                                <TextBlock Text="Cloudflare API Token *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Name="TxtCloudflareToken" Grid.Column="0" Margin="0,0,8,0"/>
                                    <TextBox Name="TxtCloudflareTokenVisible" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <Button Name="BtnToggleCloudflareToken" Grid.Column="1" Content="Show"
                                            Background="#334155" Foreground="White" Padding="14,6" FontSize="12" Cursor="Hand" BorderThickness="0"/>
                                </Grid>
                                <TextBlock Text="Requires Zone.DNS Edit permissions. Get it from Cloudflare Dashboard > Profile > API Tokens" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <TextBlock Text="Cloudflare Zone ID (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBox Name="TxtCloudflareZoneId" Margin="0,0,0,6"/>
                                <TextBlock Text="Leave blank to automatically discover the Zone ID using your Root Domain." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Domain & Network Settings -->
                    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Domain &amp; Port Settings" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            <TextBlock Text="Configure your domain zone and Minecraft local server port." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Root Domain *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtRootDomain" Text=""/>
                                    <TextBlock Text="e.g. yourdomain.com (Required)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SRV Record Name *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtSrvRecordName" Text="_minecraft._tcp.play"/>
                                    <TextBlock Text="e.g. _minecraft._tcp.play (Required)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Local Minecraft Port *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtLocalPort" Text="25565"/>
                                    <TextBlock Text="Port your local server listens on (default: 25565)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hot-Swap Interval (Minutes) *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtHotSwapMinute" Text="55"/>
                                    <TextBlock Text="Pre-starts next tunnel before 60-min Pinggy limit (default: 55)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SRV Priority *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtPriority" Text="0"/>
                                    <TextBlock Text="Priority of the SRV record (0-65535, default: 0)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SRV Weight *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtWeight" Text="5"/>
                                    <TextBlock Text="Weight of the SRV record (0-65535, default: 5)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DNS TTL (Seconds) *" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtTTL" Text="60"/>
                                    <TextBlock Text="Time-To-Live in seconds for fast updates (default: 60)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Log Retention (Days)" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtLogRetention" Text="14"/>
                                    <TextBlock Text="Auto-purges old logs on startup (default: 14)" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SAVE BUTTON -->
                    <Button Name="BtnSaveSettings" Content="Save Settings to .env"
                            Height="46" Background="#0284C7" Foreground="White" FontSize="15" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,24"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= PAGE 3: FULL LIVE LOGS ================= -->
            <Grid Name="PanelLogs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Name="ChkAutoScroll" Content="Auto-scroll to bottom" Foreground="#94A3B8" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Name="BtnClearLogView" Content="Clear View" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Name="BtnOpenLogFile" Content="Open in Notepad" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Name="BtnOpenLogFolder" Content="Open Logs Folder" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock Name="TxtFullLogPath" Text="" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Border Grid.Row="1" Background="#0B132B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="12">
                    <TextBox Name="TxtFullLogs"
                             Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                             FontFamily="Consolas, monospace" FontSize="12"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
