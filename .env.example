# ============================================================
# TunnelKeeper Gateway - Environment Configuration Template
# Copy this file to .env and adjust values for your server.
# ============================================================

# [PROVIDER] Choose your DNS provider: "Hostinger" or "Cloudflare" (default: Hostinger)
DnsProvider=Hostinger

# ---- Hostinger Configuration (Required if DnsProvider=Hostinger) ----
HostingerToken=YOUR_HOSTINGER_API_TOKEN_HERE

# ---- Cloudflare Configuration (Required if DnsProvider=Cloudflare) ----
# Create a scoped token at Cloudflare Dashboard > My Profile > API Tokens (Zone.DNS Edit permission)
CloudflareApiToken=YOUR_CLOUDFLARE_API_TOKEN_HERE
# Optional: if omitted, Zone ID is auto-discovered using RootDomain
# CloudflareZoneId=YOUR_CLOUDFLARE_ZONE_ID_HERE

# ---- Common DNS & Domain Settings (REQUIRED) ----
# RootDomain: The registered domain zone managed on your DNS provider (e.g., example.com, yourdomain.com)
RootDomain=yourdomain.com

# SrvRecordName: The SRV record label within the DNS zone
# e.g., "_minecraft._tcp.play" allows players to connect to "play.yourdomain.com"
# e.g., "_minecraft._tcp" allows players to connect to "yourdomain.com" directly
SrvRecordName=_minecraft._tcp.play

# TTL: Time-to-Live in seconds for fast DNS propagation upon tunnel swaps (recommended: 60)
TTL=60

# Priority: SRV record priority (0 - 65535, lower number = higher priority, default: 0)
Priority=0

# Weight: SRV record weight for load-balancing (0 - 65535, default: 5)
Weight=5

# ---- Server & Hot-Swap Settings ----
# LocalPort: The local port your Minecraft server is listening on (Java default: 25565)
LocalPort=25565

# HotSwapMinute: Minutes to wait before pre-starting a replacement Pinggy tunnel (range: 5 - 59, default: 55)
# Pinggy free tunnels expire after 60 minutes; 55 minutes ensures 0 downtime.
HotSwapMinute=55

# ---- Log Retention Settings ----
# LogRetentionDays: Number of days of rotated log files to keep in %USERPROFILE%\TunnelKeeper_Logs
LogRetentionDays=14
